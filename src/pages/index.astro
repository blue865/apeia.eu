---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GalleryCard from '../components/GalleryCard.astro';
import PostCard from '../components/PostCard.astro';
import ShardDecor from '../components/ShardDecor.astro';
import { formatDate } from '../lib/format.ts';
import { getHomeBackgrounds } from '../lib/homeBackgrounds.ts';
import { galleryActivityDate, byActivityDesc } from '../lib/galleryDates.ts';

// The home now *defaults to the Astro room*: Astro takes the lead — a gallery
// preview and recent posts — while Shards is reachable through a clear doorway
// and the segmented section switch in the hero. Nothing is hidden; the page
// just declares a primary side.

type RecentItem = {
  title: string;
  date: Date;
  href: string;
  kind: 'post' | 'gallery';
};

const astroPosts = (await getCollection('astro-posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const astroGalleries = (await getCollection('astro-gallery', ({ data }) => !data.draft))
  .sort(byActivityDesc);

const shardsPostsRaw = await getCollection('shards-posts', ({ data }) => !data.draft);
const shardsGalleriesRaw = await getCollection('shards-gallery', ({ data }) => !data.draft);

// Recent Shards items are a *mix* of posts and galleries, newest first — they
// feed the doorway so the other room still surfaces fresh work.
function recentMix(
  posts: { id: string; data: { title: string; date: Date } }[],
  galleries: { id: string; data: { title: string; date: Date; images?: { added?: Date }[] } }[],
  section: 'astro' | 'shards',
): RecentItem[] {
  const items: RecentItem[] = [
    ...posts.map((p) => ({
      title: p.data.title,
      date: p.data.date,
      href: `/${section}/blog/${p.id}`,
      kind: 'post' as const,
    })),
    ...galleries.map((g) => ({
      title: g.data.title,
      date: galleryActivityDate(g),
      href: `/${section}/gallery/${g.id}`,
      kind: 'gallery' as const,
    })),
  ];
  items.sort((a, b) => b.date.valueOf() - a.date.valueOf());
  return items;
}

const shardsRecent = recentMix(shardsPostsRaw, shardsGalleriesRaw, 'shards').slice(0, 4);

// Top Astro galleries become the visual lead, rendered as cover cards.
const astroFeature = astroGalleries.slice(0, 4).map((g) => ({
  href: `/astro/gallery/${g.id}`,
  title: g.data.title,
  date: galleryActivityDate(g),
  cover: g.data.cover ?? g.data.images?.[0]?.file,
  description: g.data.description,
  count: g.data.images?.length,
}));

const bgCandidates = await getHomeBackgrounds();
---

<Base title="apeia.eu" section="home">
  {bgCandidates.length > 0 && (
    <>
      <div class="page-bg" id="page-bg" aria-hidden="true"></div>
      <div class="page-bg-veil" aria-hidden="true"></div>
      <script is:inline define:vars={{
        picks: bgCandidates.map((b) => ({ src: b.src, a: b.accents.astro, s: b.accents.shards })),
      }}>
        (() => {
          try {
            if (!Array.isArray(picks) || picks.length === 0) return;
            const el = document.getElementById('page-bg');
            if (!el) return;
            const pick = picks[Math.floor(Math.random() * picks.length)];
            const root = document.documentElement;
            if (pick.a) root.style.setProperty('--color-accent-astro', pick.a);
            if (pick.s) root.style.setProperty('--color-accent-shards', pick.s);
            const img = new Image();
            img.onload = () => {
              el.style.backgroundImage = 'url("' + pick.src + '")';
              el.classList.add('is-loaded');
            };
            img.onerror = () => { el.classList.add('is-loaded'); };
            img.src = pick.src;
          } catch (_) { /* fail silent */ }
        })();
      </script>
    </>
  )}

  <section class="hero container-wide">
    <p class="kicker">/synoptics/</p>
    <h1>Mostly from the garden.</h1>
    <p class="sub">
      <span class="accent-astro">One looks up</span>;
      <span class="accent-shards">the other looks in</span>.
    </p>
  </section>

  {astroFeature.length > 0 && (
    <section class="container-wide block astro-zone">
      <header class="block-head">
        <h2>Recent from the sky</h2>
        <a href="/astro" class="see-all">Enter Astro →</a>
      </header>
      <ul class="gallery-grid">
        {astroFeature.map((g) => (
          <li>
            <GalleryCard
              href={g.href}
              title={g.title}
              date={g.date}
              cover={g.cover}
              description={g.description}
              count={g.count}
              section="astro"
            />
          </li>
        ))}
      </ul>
    </section>
  )}

  {astroPosts.length > 0 && (
    <section class="container block astro-zone">
      <header class="block-head">
        <h2>Latest notes from the garden</h2>
        <a href="/astro/blog" class="see-all">All posts →</a>
      </header>
      <ul class="post-list">
        {astroPosts.slice(0, 4).map((p) => (
          <PostCard
            href={`/astro/blog/${p.id}`}
            title={p.data.title}
            date={p.data.date}
            summary={p.data.summary}
          />
        ))}
      </ul>
    </section>
  )}

  <section class="container-wide doorway-wrap">
    <a class="doorway" href="/shards">
      <ShardDecor variant="block" />
      <div class="doorway-copy">
        <span class="eyebrow">Shards</span>
        <h2>Looking in</h2>
        <p>The Synoptic Gospels of a Society in Search of Meaning - gardening section.</p>
        <span class="more">Read the writing →</span>
      </div>
      {shardsRecent.length > 0 && (
        <ul class="doorway-recent">
          {shardsRecent.map((item) => (
            <li>
              <span class="d-date">{formatDate(item.date)}</span>
              <span class="d-title">
                {item.title}
                {item.kind === 'gallery' && <span class="d-kind">gallery</span>}
              </span>
            </li>
          ))}
        </ul>
      )}
    </a>
  </section>
</Base>

<style>
  /* ---- Random full-page background (tagged home-page) ---- */
  .page-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    background-color: var(--color-bg-deep);
    opacity: 0;
    transition: opacity 600ms ease;
  }
  .page-bg.is-loaded { opacity: 1; }

  .page-bg-veil {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(180deg,
        rgba(17,19,24,0.10) 0%,
        rgba(17,19,24,0.10) 30%,
        rgba(17,19,24,0.62) 72%,
        rgba(17,19,24,0.92) 100%);
  }
  :global(html:has(#page-bg)) { background-image: none; }

  /* ---- Hero ---- */
  .hero {
    position: relative;
    padding: var(--space-7) var(--space-5) var(--space-5);
    overflow: hidden;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
  }
  .kicker {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.18em;
    color: var(--color-text);
    opacity: 0.85;
    text-transform: uppercase;
  }
  .hero h1 {
    font-family: var(--font-display-astro);
    font-size: var(--fs-xl);
    line-height: 1.15;
    max-width: 24ch;
    margin: 0 0 var(--space-3);
    letter-spacing: -0.01em;
    font-weight: 500;
  }
  .hero .sub {
    color: rgba(226, 228, 234, 0.82);
    font-size: var(--fs-sm);
    max-width: 56ch;
    margin: 0 0 var(--space-5);
  }
  .accent-astro  { color: var(--color-accent-astro); }
  .accent-shards { color: var(--color-accent-shards); }

  /* ---- Shared block scaffolding ---- */
  .block { padding: var(--space-6) var(--space-5); }
  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    border-bottom: 1px solid var(--color-border-soft);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .block-head h2 { margin: 0; font-size: var(--fs-lg); font-family: var(--font-display-astro); }
  .see-all {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    border-bottom: 1px solid transparent;
    white-space: nowrap;
  }
  .see-all:hover { color: var(--color-accent-astro); border-bottom-color: var(--color-accent-astro); }

  /* Locally theme the Astro lead so child cards pick up the mint accent
     without flipping the whole page's section binding. */
  .astro-zone {
    --accent: var(--color-accent-astro);
    --accent-rgb: 93, 214, 200;
    --accent-line: rgba(93, 214, 200, 0.35);
  }

  .gallery-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-5);
  }
  .post-list { list-style: none; padding: 0; margin: 0; }

  /* ---- Shards doorway (secondary, but clearly inviting) ---- */
  .doorway-wrap { padding: var(--space-2) var(--space-5) var(--space-4); }
  .doorway {
    --accent: var(--color-accent-shards);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-1) var(--space-5);
    color: var(--color-text);
    background: rgba(26, 29, 36, 0.55);
    backdrop-filter: blur(10px) saturate(115%);
    -webkit-backdrop-filter: blur(10px) saturate(115%);
    border: 1px solid var(--color-border-soft);
    border-left: 2px solid var(--color-accent-shards);
    clip-path: var(--motif-shards-cut);
    border-radius: 0;
    transition: background 200ms ease, transform 200ms ease, border-color 200ms ease;
  }
  .doorway:hover { transform: translateY(-2px); background: rgba(232, 168, 124, 0.06); }
  .doorway :global(svg) {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 60%;
    z-index: 0;
    opacity: 0.4;
  }
  .doorway > * { position: relative; z-index: 1; }

  .doorway .eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-shards);
    margin: 0 0 var(--space-2);
  }
  .doorway h2 {
    font-family: var(--font-display-shards);
    font-size: var(--fs-lg);
    margin: 0 0 var(--space-2);
    line-height: 1.15;
  }
  .doorway-copy {
    align-self: start;
  }
  .doorway-copy p {
    color: rgba(226, 228, 234, var(--text-medium));
    margin: 0 0 var(--space-3);
    max-width: 44ch;
  }
  .doorway .more {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    transition: color var(--t-fast);
  }
  .doorway:hover .more { color: var(--color-accent-shards); }

  .doorway-recent { list-style: none; padding: 0; margin: 0; }
  .doorway-recent li {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2em 0.7em;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border-soft);
  }
  .doorway-recent .d-date { flex: none; }
  .doorway-recent li:last-child { border-bottom: none; }
  .d-date {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  .d-title {
    color: rgba(226, 228, 234, var(--text-body));
    font-family: var(--font-display-shards);
    font-size: var(--fs-sm);
  }
  .d-kind {
    margin-left: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.7em;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    opacity: 0.75;
    vertical-align: 0.05em;
  }

  @media (max-width: 720px) {
    .doorway { grid-template-columns: 1fr; gap: var(--space-5); }
  }
</style>

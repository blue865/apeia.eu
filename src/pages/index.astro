---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import OrbitalDecor from '../components/OrbitalDecor.astro';
import ShardDecor from '../components/ShardDecor.astro';
import { formatDate } from '../lib/format.ts';
import { getHomeBackgrounds } from '../lib/homeBackgrounds.ts';
import { galleryActivityDate, byActivityDesc } from '../lib/galleryDates.ts';

// The home now *defaults to the Astro room*: Astro takes the lead — a gallery
// preview and recent posts — while Shards is reachable through a clear doorway
// and the segmented section switch in the hero. Nothing is hidden; the page
// just declares a primary side.

type RecentItem = {
  title: string;
  date: Date;
  href: string;
  kind: 'post' | 'gallery';
};

const astroPosts = (await getCollection('astro-posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const astroGalleries = (await getCollection('astro-gallery', ({ data }) => !data.draft))
  .sort(byActivityDesc);

const shardsPostsRaw = await getCollection('shards-posts', ({ data }) => !data.draft);
const shardsGalleriesRaw = await getCollection('shards-gallery', ({ data }) => !data.draft);

// Recent Shards items are a *mix* of posts and galleries, newest first — they
// feed the doorway so the other room still surfaces fresh work.
function recentMix(
  posts: { id: string; data: { title: string; date: Date } }[],
  galleries: { id: string; data: { title: string; date: Date; images?: { added?: Date }[] } }[],
  section: 'astro' | 'shards',
): RecentItem[] {
  const items: RecentItem[] = [
    ...posts.map((p) => ({
      title: p.data.title,
      date: p.data.date,
      href: `/${section}/blog/${p.id}`,
      kind: 'post' as const,
    })),
    ...galleries.map((g) => ({
      title: g.data.title,
      date: galleryActivityDate(g),
      href: `/${section}/gallery/${g.id}`,
      kind: 'gallery' as const,
    })),
  ];
  items.sort((a, b) => b.date.valueOf() - a.date.valueOf());
  return items;
}

// The Astro card leads with a single featured image: the newest gallery's
// leading frame (its `cover`, or the first image when no cover is set). It
// pulls the eye toward the photographs without crowding the page.
const featuredAstroGallery = astroGalleries[0];
const featuredAstroHref = featuredAstroGallery
  ? `/astro/gallery/${featuredAstroGallery.id}`
  : undefined;
const featuredAstroCover = featuredAstroGallery
  ? (featuredAstroGallery.data.cover ?? featuredAstroGallery.data.images[0].file)
  : undefined;

// Drop the featured gallery from the list below so it isn't shown twice.
const astroRecent = recentMix(astroPosts, astroGalleries, 'astro')
  .filter((item) => item.href !== featuredAstroHref)
  .slice(0, 4);
const shardsRecent = recentMix(shardsPostsRaw, shardsGalleriesRaw, 'shards').slice(0, 4);

const bgCandidates = await getHomeBackgrounds();
---

<Base title="apeia.eu" section="home">
  {bgCandidates.length > 0 && (
    <>
      <div class="page-bg" id="page-bg" aria-hidden="true"></div>
      <div class="page-bg-veil" aria-hidden="true"></div>
      <script is:inline define:vars={{
        picks: bgCandidates.map((b) => ({ src: b.src, a: b.accents.astro, s: b.accents.shards })),
      }}>
        (() => {
          try {
            if (!Array.isArray(picks) || picks.length === 0) return;
            const el = document.getElementById('page-bg');
            if (!el) return;
            const pick = picks[Math.floor(Math.random() * picks.length)];
            const root = document.documentElement;
            if (pick.a) root.style.setProperty('--color-accent-astro', pick.a);
            if (pick.s) root.style.setProperty('--color-accent-shards', pick.s);
            const img = new Image();
            img.onload = () => {
              el.style.backgroundImage = 'url("' + pick.src + '")';
              el.classList.add('is-loaded');
            };
            img.onerror = () => { el.classList.add('is-loaded'); };
            img.src = pick.src;
          } catch (_) { /* fail silent */ }
        })();
      </script>
    </>
  )}

  <section class="hero container-wide">
    <p class="kicker">/synoptics/</p>
    <h1>Mostly from the garden</h1>
  </section>

  <section class="container-wide doorway-wrap">
    <div class="doorway astro">
      <OrbitalDecor variant="block" />
      <div class="doorway-copy">
        <a class="doorway-head" href="/astro">
          <span class="eyebrow">Astro</span>
          <h2>Looking up</h2>
        </a>
        <p>Long exposures guarded by <a class="inline-link" href="/shards/tags/four-guardians">Gastonne, Gépardinne, Erwinne and the mighty Pedro</a> - the little pail.</p>
        <span class="more">See the photographs →</span>
      </div>
      {(featuredAstroCover || astroRecent.length > 0) && (
        <div class="doorway-side">
          {featuredAstroCover && featuredAstroGallery && (
            <a class="featured-gallery" href={featuredAstroHref}>
              <Image
                src={featuredAstroCover}
                alt={featuredAstroGallery.data.title}
                width={480}
                height={300}
              />
              <span class="featured-tag">
                <span class="featured-kind">Latest</span>
                <span class="featured-title">
                  {featuredAstroGallery.data.name ?? featuredAstroGallery.data.title}
                </span>
              </span>
            </a>
          )}
          {astroRecent.length > 0 && (
            <p class="recent-label">Recent</p>
          )}
          <ul class="doorway-recent">
            {astroRecent.map((item) => (
              <li>
                <a href={item.href}>
                  <span class="d-date">{formatDate(item.date)}</span>
                  <span class="d-title">
                    {item.title}
                    {item.kind === 'gallery' && <span class="d-kind">gallery</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <section class="container-wide doorway-wrap">
    <div class="doorway shards">
      <ShardDecor variant="block" />
      <a class="doorway-copy" href="/shards">
        <span class="eyebrow">Shards</span>
        <h2>Looking in</h2>
        <p>The Synoptic Gospels of a Society in Search of Meaning - gardening section.</p>
        <span class="more">Read the writings →</span>
      </a>
      {shardsRecent.length > 0 && (
        <div class="doorway-side">
          <p class="recent-label">Recent</p>
          <ul class="doorway-recent">
            {shardsRecent.map((item) => (
              <li>
                <a href={item.href}>
                  <span class="d-date">{formatDate(item.date)}</span>
                  <span class="d-title">
                    {item.title}
                    {item.kind === 'gallery' && <span class="d-kind">gallery</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  /* ---- Random full-page background (tagged home-page) ---- */
  .page-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    background-color: var(--color-bg-deep);
    opacity: 0;
    transition: opacity 600ms ease;
  }
  .page-bg.is-loaded { opacity: 0.7; }

  .page-bg-veil {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(180deg,
        rgba(17,19,24,0.10) 0%,
        rgba(17,19,24,0.10) 30%,
        rgba(17,19,24,0.62) 72%,
        rgba(17,19,24,0.92) 100%);
  }
  :global(html:has(#page-bg)) { background-image: none; }

  /* ---- Hero ---- */
  .hero {
    position: relative;
    padding: var(--space-7) var(--space-5) var(--space-5);
    overflow: hidden;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
  }
  .kicker {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.18em;
    color: var(--color-text);
    opacity: 0.85;
    text-transform: uppercase;
  }
  .hero h1 {
    font-family: var(--font-display-astro);
    font-size: var(--fs-xl);
    line-height: 1.15;
    max-width: 24ch;
    margin: 0 0 var(--space-3);
    letter-spacing: -0.01em;
    font-weight: 500;
  }
  .hero .sub {
    color: rgba(226, 228, 234, 0.82);
    font-size: var(--fs-sm);
    max-width: 56ch;
    margin: 0 0 var(--space-5);
  }
  .accent-astro  { color: var(--color-accent-astro); }
  .accent-shards { color: var(--color-accent-shards); }

  /* ---- Section doorways (two equal cards: Astro + Shards) ---- */
  .doorway-wrap { padding: var(--space-2) var(--space-5) var(--space-4); }
  .doorway {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-6);
    align-items: start;
    padding: var(--space-3) var(--space-5);
    color: var(--color-text);
    background: rgba(26, 29, 36, 0.6);
    backdrop-filter: blur(1px) saturate(115%);
    -webkit-backdrop-filter: blur(10px) saturate(115%);
    border: 1px solid var(--color-border-soft);
    border-left: 2px solid var(--accent);
    transition: background 200ms ease, transform 200ms ease, border-color 200ms ease;
  }
  /* Transparency + hover are shared across both cards (Shards settings). */
  .doorway:hover {
    transform: translateY(-2px);
    background: rgba(232, 168, 124, 0.06);
  }

  /* Per-section identity: accent, motif, headline font. */
  .doorway.astro {
    --accent: var(--color-accent-astro);
    border-radius: 14px;
  }
  .doorway.shards {
    --accent: var(--color-accent-shards);
    clip-path: var(--motif-shards-cut);
    border-radius: 0;
  }
  .doorway :global(svg) {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 60%;
    z-index: 0;
    opacity: 0.6;
  }
  /* The Astro card's featured image occupies the top-right where the shared
     motif lives, so re-anchor the orbital to the left, behind the copy, where
     it reads as a faint background motif just like the Shards lines do. */
  .doorway.astro :global(svg) {
    inset: 50% auto auto -14%;
    transform: translateY(-50%);
    width: 52%;
  }
  .doorway > * { position: relative; z-index: 1; }

  /* Shared mono "chrome" label — the connective tissue that frames the
     serif headline and titles. Used by the brand eyebrow and the Latest tag. */
  .doorway .eyebrow,
  .doorway .recent-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 var(--space-2);
    line-height: 1;
  }
  .doorway .eyebrow { color: var(--accent); }
  .doorway .recent-label { color: var(--color-text-muted); }

  .doorway h2 {
    font-size: var(--fs-lg);
    font-weight: 400;
    margin: 0 0 var(--space-2);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  /* Astro card: one clean sans family across every element on the card. */
  .doorway.astro,
  .doorway.astro .eyebrow,
  .doorway.astro .recent-label,
  .doorway.astro .more,
  .doorway.astro .d-date,
  .doorway.astro .d-kind,
  .doorway.astro .doorway-copy p { font-family: var(--font-body-astro); }
  .doorway.astro h2 { font-family: var(--font-body-astro); }
  .doorway.shards h2 { font-family: var(--font-display-shards); }
  .doorway-copy {
    display: block;
    position: relative;
    /* Fill the full row height so the stretched link below covers the empty
       space beneath the CTA (the right column is usually taller). */
    align-self: stretch;
    color: var(--color-text);
    border-bottom: none;
  }
  .doorway-copy:hover { border-bottom: none; }
  .doorway-head {
    display: block;
    color: var(--color-text);
    border-bottom: none;
  }
  .doorway-head:hover { border-bottom: none; }
  /* The whole left column is the link to /astro: the heading's link is
     stretched to cover the column. The inline "four guardians" link is
     lifted above the overlay so it stays independently clickable. */
  .doorway-head::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .doorway-copy .inline-link {
    position: relative;
    z-index: 1;
  }
  .doorway-copy p {
    color: rgba(226, 228, 234, var(--text-medium));
    font-size: var(--fs-sm);
    line-height: 1.5;
    margin: 0 0 var(--space-4);
    max-width: 40ch;
  }
  /* CTA joins the mono chrome family so the copy is framed top and bottom
     by the same voice. */
  .doorway .more {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color var(--t-fast);
    border-bottom: none;
  }
  .doorway .more:hover { border-bottom: none; }
  .doorway:hover .more { color: var(--accent); }

  .doorway-side { min-width: 0; }

  /* Featured gallery — the Astro card leads with the newest gallery's image,
     a quiet focal point that pulls the eye toward the photographs. */
  .featured-gallery {
    display: block;
    position: relative;
    margin: 0 0 var(--space-4);
    overflow: hidden;
    border: 1px solid var(--color-border-soft);
    border-radius: 10px;
    border-bottom: none;
    transition: border-color var(--t-fast), transform 200ms ease;
  }
  .featured-gallery:hover {
    border-bottom: none;
    border-color: var(--accent-line);
    transform: translateY(-2px);
  }
  .featured-gallery :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 500ms ease;
  }
  .featured-gallery:hover :global(img) { transform: scale(1.04); }
  .featured-tag {
    position: absolute;
    left: var(--space-2);
    bottom: var(--space-2);
    display: inline-flex;
    align-items: baseline;
    gap: 0.55em;
    padding: 0.22em 0.6em;
    background: rgba(12, 14, 18, 0.62);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 6px;
  }
  .featured-kind {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .featured-title {
    font-family: var(--font-body-astro);
    font-size: var(--fs-xs);
    color: rgba(226, 228, 234, var(--text-high));
  }

  .doorway-recent { list-style: none; padding: 0; margin: 0; }
  .doorway-recent li {
    border-bottom: 1px solid var(--color-border-soft);
  }
  .doorway-recent li:first-child { border-top: 1px solid var(--color-border-soft); }
  .doorway-recent a {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15em 0.8em;
    padding: var(--space-2) 0;
    color: var(--color-text);
    border-bottom: none;
    transition: color var(--t-fast);
  }
  .doorway-recent a:hover { border-bottom: none; }
  .doorway-recent a:hover .d-title { color: var(--accent); }
  /* Fixed date rail so the serif titles align into a tidy column. */
  .d-date {
    flex: none;
    min-width: 5.5em;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  .d-title {
    color: rgba(226, 228, 234, var(--text-body));
    font-size: var(--fs-sm);
    line-height: 1.3;
    transition: color var(--t-fast);
  }
  .doorway.astro .d-title { font-family: var(--font-body-astro); }
  .doorway.shards .d-title { font-family: var(--font-display-shards); }
  .d-kind {
    margin-left: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.7em;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    opacity: 0.75;
    vertical-align: 0.05em;
  }

  @media (max-width: 720px) {
    .doorway { grid-template-columns: 1fr; gap: var(--space-5); }
  }
</style>

---
import { getCollection } from 'astro:content';
import SectionLayout from '../../../layouts/SectionLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import ShardDecor from '../../../components/ShardDecor.astro';

const posts = (await getCollection('shards-posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<SectionLayout
  title="Shards — blog"
  description="Essays and shorter pieces from apeia.eu — philosophy, science, politics, personal."
  section="shards"
  eyebrow="Shards · Blog"
  heading="Writings."
  lede=""
  crumb={{ label: 'Shards', href: '/shards' }}
>
  <div class="page-decor" aria-hidden="true">
    <ShardDecor variant="hero" />
  </div>

  <section class="container">
    {posts.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : (
      <ul class="list">
        {posts.map((p) => (
          <PostCard
            href={`/shards/blog/${p.id}`}
            title={p.data.title}
            date={p.data.date}
            summary={p.data.summary}
            topic={p.data.topic}
          />
        ))}
      </ul>
    )}
  </section>
</SectionLayout>

<style>
  .list { list-style: none; padding: 0; margin: 0; }
  .empty { color: var(--color-text-muted); padding: var(--space-7) 0; }

  /* Shards crystalline facets as a fixed page background — echoes the shard
     graphics on the home page's Shards card. Decorative, behind all content. */
  .page-decor {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .page-decor :global(.shard) {
    position: absolute;
    inset: -10% auto auto -12%;
    width: min(760px, 88vw);
    height: min(760px, 88vw);
    opacity: 0.42;
  }
</style>

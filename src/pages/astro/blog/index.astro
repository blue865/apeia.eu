---
import { getCollection } from 'astro:content';
import SectionLayout from '../../../layouts/SectionLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import OrbitalDecor from '../../../components/OrbitalDecor.astro';

const posts = (await getCollection('astro-posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<SectionLayout
  title="Astro — blog"
  description="Posts from the apeia.eu astrophotography blog."
  section="astro"
  eyebrow="Astro · Blog"
  heading="Notes from the dark."
  crumb={{ label: 'Astro', href: '/astro' }}
>
  <div class="page-decor" aria-hidden="true">
    <OrbitalDecor variant="hero" />
  </div>

  <section class="container">
    {posts.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : (
      <ul class="list">
        {posts.map((p) => (
          <PostCard
            href={`/astro/blog/${p.id}`}
            title={p.data.title}
            date={p.data.date}
            summary={p.data.summary}
          />
        ))}
      </ul>
    )}
  </section>
</SectionLayout>

<style>
  .list { list-style: none; padding: 0; margin: 0; }
  .empty { color: var(--color-text-muted); padding: var(--space-7) 0; }

  /* Astro orbital rings as a fixed page background — echoes the circle
     graphics on the home page's Astro card. Decorative, behind all content. */
  .page-decor {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .page-decor :global(.orbital) {
    position: absolute;
    inset: -12% -14% auto auto;
    width: min(820px, 90vw);
    height: min(820px, 90vw);
    opacity: 0.4;
  }
</style>

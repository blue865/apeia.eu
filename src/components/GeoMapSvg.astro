---
/**
 * GeoMapSvg — the location chart itself, shared by the in-flow GeoMap figure and
 * its fullscreen overlay. Static, build-time SVG on an equirectangular map:
 * Natural Earth coastline + country borders, a faint graticule, and an accent
 * dot for every located point.
 *
 * Two variants:
 *  - `gallery`: auto-fitted to the gallery's own points, one dot per image,
 *    labels on hover (a summit full of photos shouldn't stack 30 labels).
 *  - `global`:  the world extent of all travels, one dot per gallery with a
 *    persistent, collision-avoided label.
 *
 * `interactive: false` renders markers without links — used inside the
 * fullscreen overlay, which is itself one big close-link.
 *
 * Base geometry: Natural Earth (public domain) via `scripts/build-geomap.mjs`.
 */
import coastline110 from '../data/geomap/coastline-110m.json';
import borders110 from '../data/geomap/borders-110m.json';
import coastline50 from '../data/geomap/coastline-50m.json';
import borders50 from '../data/geomap/borders-50m.json';
import {
  computeBox,
  makeProjector,
  heightForBox,
  splitAtWrap,
  clipPolylines,
  graticule,
  niceStep,
  type GeoBox,
} from '../lib/geomap';

export interface GeoMarker {
  lat: number;
  lon: number;
  label: string;
  href: string;
  count?: number;
}

interface Props {
  points: GeoMarker[];
  variant?: 'gallery' | 'global';
  interactive?: boolean;
}
const { points, variant = 'gallery', interactive = true } = Astro.props;

const W = 960;
const PAD = 18;

const box: GeoBox =
  variant === 'global'
    ? computeBox(points, { padFrac: 0.45, minSpanKm: 150 })
    : computeBox(points, { padFrac: 0.2, minSpanKm: 5 });
const H = heightForBox(box, W);
const proj = makeProjector(box, W, H, PAD);

type Line = [number, number][];

function toPath(part: Line): string {
  return (
    'M' +
    part
      .map((pt) => {
        const { x, y } = proj(pt[0], pt[1]);
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      })
      .join('L')
  );
}

/* ---- base geometry: 110m at world scale, 50m once zoomed to a region/island
   (110m omits small islands like the Canaries). Clipped to the frame, then
   seam-split. ---- */
const lonSpan = box.lonMax - box.lonMin;
const latSpan = box.latMax - box.latMin;
const wide = Math.max(lonSpan, latSpan) > 30;
const coastline = (wide ? coastline110 : coastline50) as Line[];
const borders = (wide ? borders110 : borders50) as Line[];

const coastPath = clipPolylines(coastline, box)
  .flatMap((l) => splitAtWrap(l))
  .map(toPath)
  .join('');
const borderPath = clipPolylines(borders, box)
  .flatMap((l) => splitAtWrap(l))
  .map(toPath)
  .join('');

/* ---- graticule ---- */
const step = niceStep(Math.max(lonSpan, latSpan));
const grat = graticule(box, step);
const gratPath = [...grat.meridians, ...grat.parallels].map(toPath).join('');

/* ---- markers ---- */
const projected = points.map((p) => {
  const { x, y } = proj(p.lon, p.lat);
  return { ...p, x, y };
});

/* Persistent, collision-avoided labels — global variant only (few galleries).
   Mirrors the Sky Map's build-time placement: default to the right of the dot,
   flip left near the edge, nudge vertically until a free slot is found. */
const CHAR_W = 6.5;
const LABEL_H = 13;
type Rect = { x1: number; y1: number; x2: number; y2: number };
const placed: Rect[] = [];
const overlaps = (r: Rect) =>
  placed.some((p) => r.x1 < p.x2 && r.x2 > p.x1 && r.y1 < p.y2 && r.y2 > p.y1);

const markers = projected.map((m) => {
  const showLabel = variant === 'global';
  let labelX = m.x + 11;
  let anchor: 'start' | 'end' = 'start';
  let labelY = m.y + 3.5;
  if (showLabel) {
    const w = m.label.length * CHAR_W;
    if (labelX + w > W - 4) {
      labelX = m.x - 11;
      anchor = 'end';
    }
    for (const dy of [0, 15, -15, 30, -30, 45, -45]) {
      const x1 = anchor === 'start' ? labelX : labelX - w;
      const rect = { x1, y1: m.y + 3.5 + dy - LABEL_H, x2: x1 + w, y2: m.y + 3.5 + dy };
      if (!overlaps(rect)) {
        placed.push(rect);
        labelY = m.y + 3.5 + dy;
        break;
      }
    }
  }
  // Hover tooltip (both variants), clamped to the chart, above unless too high.
  const tip = m.count && m.count > 1 ? `${m.label} · ${m.count} photos` : m.label;
  const tipW = tip.length * 6 + 14;
  const tipX = Math.min(Math.max(m.x, PAD + tipW / 2 + 2), W - PAD - tipW / 2 - 2);
  const tipAbove = m.y > 34;
  return { ...m, showLabel, labelX, labelY, anchor, tip, tipW, tipX, tipAbove };
});

const aria =
  variant === 'global'
    ? `Map of ${points.length} located galler${points.length === 1 ? 'y' : 'ies'}`
    : `Map of ${points.length} located photo${points.length === 1 ? '' : 's'}`;
---

<svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" role="img" aria-label={aria}>
  <!-- graticule -->
  <g class="grat" aria-hidden="true"><path d={gratPath} /></g>

  <!-- coastline + borders -->
  <g class="coast" aria-hidden="true"><path d={coastPath} /></g>
  <g class="borders" aria-hidden="true"><path d={borderPath} /></g>

  <!-- located points -->
  <g class="points">
    {markers.map((m) =>
      interactive ? (
        <a href={m.href} class="pt" aria-label={m.tip}>
          <circle class="hit" cx={m.x} cy={m.y} r="11" />
          <circle class="halo" cx={m.x} cy={m.y} r="5.5" />
          <circle class="dot" cx={m.x} cy={m.y} r="2.6" />
          {m.showLabel && (
            <text class="label" x={m.labelX} y={m.labelY} text-anchor={m.anchor}>{m.label}</text>
          )}
          <g class="tip" aria-hidden="true">
            <rect class="tip-bg" x={(m.tipX - m.tipW / 2).toFixed(1)}
                  y={m.tipAbove ? m.y - 27 : m.y + 11} width={m.tipW.toFixed(1)} height="17" rx="3" />
            <text class="tip-text" x={m.tipX.toFixed(1)}
                  y={m.tipAbove ? m.y - 15.5 : m.y + 22.5} text-anchor="middle">{m.tip}</text>
          </g>
        </a>
      ) : (
        <g class="pt">
          <title>{m.tip}</title>
          <circle class="halo" cx={m.x} cy={m.y} r="5.5" />
          <circle class="dot" cx={m.x} cy={m.y} r="2.6" />
          {m.showLabel && (
            <text class="label" x={m.labelX} y={m.labelY} text-anchor={m.anchor}>{m.label}</text>
          )}
        </g>
      ),
    )}
  </g>
</svg>

<style>
  svg { display: block; width: 100%; height: auto; }

  .grat path {
    fill: none;
    stroke: rgba(226, 228, 234, 0.05);
    stroke-width: 1;
  }
  .coast path {
    fill: none;
    stroke: rgba(122, 127, 146, 0.55);
    stroke-width: 0.9;
    stroke-linejoin: round;
  }
  .borders path {
    fill: none;
    stroke: rgba(122, 127, 146, 0.3);
    stroke-width: 0.6;
    stroke-dasharray: 3 4;
  }

  .pt { text-decoration: none; }
  .pt .hit { fill: transparent; }
  .pt .halo {
    fill: var(--accent);
    opacity: 0.14;
    transition: opacity 150ms ease;
  }
  .pt .dot {
    fill: var(--accent);
    opacity: 0.95;
    transition: opacity 150ms ease;
  }
  .pt .label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--color-text);
    opacity: 0.7;
    transition: opacity 150ms ease;
  }
  a.pt:hover .halo, a.pt:focus .halo { opacity: 0.28; }
  a.pt:hover .label, a.pt:focus .label { opacity: 1; }

  .pt .tip { opacity: 0; pointer-events: none; transition: opacity 120ms ease; }
  a.pt:hover .tip, a.pt:focus .tip { opacity: 1; }
  .tip-bg {
    fill: rgba(17, 19, 24, 0.94);
    stroke: var(--color-border, rgba(122, 127, 146, 0.4));
    stroke-width: 0.5;
  }
  .tip-text { font-family: var(--font-mono); font-size: 10px; fill: var(--color-text); }

  @media (max-width: 640px) {
    .pt .label { font-size: 13px; }
  }
</style>

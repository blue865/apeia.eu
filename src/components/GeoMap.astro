---
/**
 * GeoMap — in-flow location chart with a fullscreen view. An icon-only pill in
 * the top-right targets a pure-CSS `:target` overlay. No JS. The chart lives in
 * GeoMapSvg.astro, rendered twice (in-flow interactive + a non-interactive copy
 * inside the overlay, which is itself one big close-link). Mirrors SkyMap.astro.
 */
import GeoMapSvg, { type GeoMarker } from './GeoMapSvg.astro';

interface Props {
  points: GeoMarker[];
  variant?: 'gallery' | 'global';
  /** Unique base id so two maps on one page don't share a :target. */
  id?: string;
  /** Optional caption under the figure. */
  caption?: string;
}
const { points, variant = 'gallery', id = 'geomap', caption } = Astro.props;
const fsId = `${id}-fs`;
---

<figure id={id} class="geomap">
  <GeoMapSvg points={points} variant={variant} />
  <div class="map-actions">
    <a class="fs-btn" href={`#${fsId}`} aria-label="View map fullscreen">
      <svg class="fs-icon" viewBox="0 0 16 16" aria-hidden="true">
        <path fill="none" stroke="currentColor" stroke-width="1.4"
              stroke-linecap="round" stroke-linejoin="round"
              d="M3 6V3h3 M10 3h3v3 M13 10v3h-3 M6 13H3v-3" />
      </svg>
    </a>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<div id={fsId} class="fs-overlay">
  <a class="fs-backdrop" href={`#${id}`} aria-label="Close fullscreen"></a>
  <a class="fs-close" href={`#${id}`} aria-label="Close fullscreen">
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path fill="none" stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round" d="M3 3l10 10M13 3L3 13" />
    </svg>
  </a>
  <div class="fs-map">
    <GeoMapSvg points={points} variant={variant} interactive={false} />
  </div>
</div>

<style>
  .geomap {
    position: relative;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius, 8px);
    background:
      radial-gradient(ellipse at 30% 0%, rgba(var(--accent-rgb), 0.05), transparent 55%),
      var(--color-bg-deep, #0c0e12);
    overflow: hidden;
  }
  body[data-section="shards"] .geomap { border-radius: 4px; }

  .geomap figcaption {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-border-soft);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .map-actions {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 2;
    display: flex;
    gap: var(--space-2);
  }

  .fs-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.5em;
    background: rgba(17, 19, 24, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 999px;
    color: rgba(226, 228, 234, 0.92);
    cursor: pointer;
    transition: background var(--t-fast, 150ms ease), border-color var(--t-fast, 150ms ease), color var(--t-fast, 150ms ease);
  }
  body[data-section="shards"] .fs-btn { border-radius: 4px; }
  .fs-btn:hover {
    background: rgba(17, 19, 24, 0.92);
    border-color: var(--accent-line);
    color: var(--accent);
  }
  .fs-icon { width: 14px; height: 14px; }

  .fs-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.96);
    align-items: center;
    justify-content: center;
    padding: var(--space-5);
  }
  .fs-overlay:target { display: flex; }
  .fs-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    cursor: zoom-out;
    border-bottom: none;
  }
  .fs-backdrop:hover { border-bottom: none; }
  .fs-map { position: relative; z-index: 1; display: block; width: 100%; max-width: 1200px; }
  .fs-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 2;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(17, 19, 24, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 999px;
    color: rgba(226, 228, 234, 0.92);
    cursor: pointer;
    transition: background var(--t-fast, 150ms ease), border-color var(--t-fast, 150ms ease), color var(--t-fast, 150ms ease);
  }
  body[data-section="shards"] .fs-close { border-radius: 4px; }
  .fs-close:hover { background: rgba(17, 19, 24, 0.92); border-color: var(--accent-line); color: var(--accent); }
  .fs-close svg { width: 14px; height: 14px; }
</style>

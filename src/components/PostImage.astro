---
/**
 * PostImage — sized image helper for MDX posts.
 *
 * Usage in an .mdx file:
 *
 *   import PostImage from '../../components/PostImage.astro';
 *   import m16 from '../astro-gallery/m16/m16-eagle-nebula.jpg';
 *
 *   <PostImage src={m16} alt="M16 — Eagle Nebula" />
 *   <PostImage src={m16} alt="M16 — Eagle Nebula" caption="Eagle Nebula" size="wide" />
 *
 * size:
 *   'prose' — fills the 65ch prose column (default)
 *   'wide'  — bleeds into the article's side padding, giving astrophotos more room
 */
import { Image } from 'astro:assets';
import { displayQuality, type Section } from '../lib/imagePresets.ts';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  size?: 'prose' | 'wide';
  /** Which section's display quality to encode at. Post images are usually
   *  gallery photographs — matching the section ladder (widths + quality)
   *  lets the build reuse the gallery page's generated files. */
  section?: Section;
}
const { src, alt, caption, size = 'prose', section = 'astro' } = Astro.props;
---

<figure class:list={['post-image', `post-image--${size}`]}>
  <Image
    {src}
    {alt}
    widths={[800, 1200, 1800]}
    format="webp"
    quality={displayQuality(section)}
    sizes={size === 'wide'
      ? '(max-width: 700px) 100vw, min(900px, calc(100vw - 3rem))'
      : '(max-width: 700px) 100vw, 65ch'}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .post-image {
    margin: var(--space-6) 0;
  }
  .post-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--color-border-soft);
  }
  /* Shards section motif override */
  body[data-section='shards'] .post-image img {
    border-radius: 0;
    clip-path: var(--motif-shards-cut);
  }
  figcaption {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-align: center;
    margin-top: var(--space-2);
  }

  /* wide: bleeds beyond the 65ch measure into the article's side padding */
  .post-image--wide {
    margin-left: calc(-1 * var(--space-5));
    margin-right: calc(-1 * var(--space-5));
  }
</style>

# apeia.eu - URL shape
#
# Astro builds every page as <path>/index.html (build.format: 'directory').
# Apache's mod_dir sees a directory request without a trailing slash and
# 301-redirects /astro/blog/post -> /astro/blog/post/ before serving that
# index file. That is why the slash appears only on the deployed site and
# never in `astro dev`; astro.config.mjs `trailingSlash: 'ignore'` cannot
# affect it, because the redirect happens on the server, not in the build.
#
# DirectorySlash Off stops the redirect. The rewrite below then serves the
# index file internally, so the slash-less URL stays in the address bar.
# Directory listings must stay off: with DirectorySlash Off, a directory
# that has no index.html would otherwise be listed instead of 404'ing.

Options -Indexes
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /path/ -> /path   (one visible 301, so already-shared slashed links converge)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /path -> /path/index.html   (internal, no redirect, slash never appears)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

ErrorDocument 404 /404.html

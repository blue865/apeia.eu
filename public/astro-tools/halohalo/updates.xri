   <platform os="all" arch="noarch" version="1.9.4:2.9.9">
      <package fileName="halohalo-1.1.zip" sha1="9e59f04fa2fde54f15018826ecfb3ec7f3199d16" type="script" releaseDate="20260920">
         <title>HaloHalo 1.1</title>
         <description>
            <p>Interactive removal of star halos. Select an ellipse around a
            halo, and the measured halo model is subtracted from the image,
            with a live preview before anything is committed.</p>
            <p>Installs as Script &gt; apeia &gt; HaloHalo.</p>
         </description>
      </package>
   </platform>

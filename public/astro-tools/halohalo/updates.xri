<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>apeia astro processing suite for PixInsight.</p>
   </description>
   <platform os="all" arch="noarch" version="1.9.4:2.9.9">
      <package fileName="greengreen-1.0.zip" sha1="38607da588724a5d6c9699a01b90cf3587aff514" type="script" releaseDate="20261020">
         <title>GreenGreen 1.0</title>
         <description>
            <p>Turn the green out, keep the colours apart: the warm hues of a stretched image are turned away from green as one piece, by a measured angle, so a red edge and a yellow body stay as far apart as they were. Optionally on the starless image, with the stars added back unchanged. One slider.</p>
            <p>Installs as Script &gt; apeia &gt; GreenGreen.</p>
         </description>
      </package>
      <package fileName="halohalo-1.3.zip" sha1="5bd623847a317b05e5412707d9f9e77def36d6b3" type="script" releaseDate="20261020">
         <title>HaloHalo 1.3</title>
         <description>
            <p>Interactive removal of star halos. Select an ellipse around a halo, and the measured halo model is subtracted from the image, with a live preview before anything is committed.</p>
            <p>Installs as Script &gt; apeia &gt; HaloHalo.</p>
         </description>
      </package>
      <package fileName="hushhush-1.1.zip" sha1="25f2c06d32c9f81008705a4b4e5c543915df0161" type="script" releaseDate="20261020">
         <title>HushHush 1.1</title>
         <description>
            <p>Quiet the stars: separate them with StarXTerminator, take the star layer down with one slider, and add it back.</p>
            <p>Installs as Script &gt; apeia &gt; HushHush.</p>
         </description>
      </package>
   </platform>
</xri>

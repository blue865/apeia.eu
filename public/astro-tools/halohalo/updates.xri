   <platform os="all" arch="noarch" version="1.8.0:2.9.9">
      <package fileName="halohalo-1.0.zip" sha1="de37d64af77507287828ce7823afb1855db59c9b" type="script" releaseDate="20260910">
         <title>HaloHalo 1.0</title>
         <description>
            <p>Interactive removal of star halos. Select an ellipse around a
            halo, and the measured halo model is subtracted from the image,
            with a live preview before anything is committed.</p>
            <p>Installs as Script &gt; apeia &gt; HaloHalo.</p>
         </description>
      </package>
   </platform>
